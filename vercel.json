{
  "buildCommand": "python manage.py collectstatic --noinput",
  "builds": [
    {
      "src": "student_ai/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "student_ai/wsgi.py"
    }
  ]
}
